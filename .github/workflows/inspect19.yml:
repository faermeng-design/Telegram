name: Inspect burn photos
on:
  workflow_dispatch:

permissions:
  contents: write

jobs:
  inspect:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Collect
        run: |
          mkdir -p inspect
          OUT=inspect/part19.txt
          J=TMessagesProj/src/main/java/org/telegram
          {
            echo "== кто вызывает markMentionMessageAsRead и markMessagesContentAsRead"
            grep -rn "markMentionMessageAsRead\|markMessagesContentAsRead\|messagesReadContent" $J --include=*.java | head -n 40
            echo
            echo "== функция около 14545"
            sed -n '14538,14580p' $J/messenger/MessagesController.java
            echo
            echo "== SecretMediaViewer: ttl, destroy, read"
            grep -n "ttl\|destroy\|markMessage\|readContent\|isSecret" $J/ui/SecretMediaViewer.java | head -n 60
          } > "$OUT" 2>&1

      - name: Commit result
        run: |
          git config user.name "github-actions"
          git config user.email "actions@users.noreply.github.com"
          git add inspect/part19.txt
          git commit -m "inspect part19" || echo "nothing to commit"
          git push
